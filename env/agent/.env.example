
HOST=0.0.0.0
PORT=8000
RELOAD=true
WATCHFILES_FORCE_POLLING=true
WATCHFILES_POLL_DELAY_MS=500
ENVIRONMENT=development
DEBUG=true
LOG_FORMAT=console
CORS_ORIGINS=["*"]

# In Docker this must be /app/data (bind-mounted from repo root data/)
# For local dev: set to absolute path of the root data/ folder
DATA_DIR=/app/data

# Local Compose Postgres for chat history and LangGraph checkpoints
POSTGRES_DB=ledgerlens
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=ledgerlens-local
DATABASE_URL=postgresql://ledgerlens:ledgerlens-local@postgres:5432/ledgerlens
LANGGRAPH_STRICT_MSGPACK=true

# Shared only with the Next.js server-side proxy; use the same random value in env/frontend/.env.local.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_API_TOKEN=replace-with-a-random-token-at-least-32-characters-long

MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
TEMPERATURE=0.0

OTEL_SERVICE_NAME=revenue-leakage-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Optional comma-separated OTLP authentication headers
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer-token

# Optional Langfuse LLM tracing
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
