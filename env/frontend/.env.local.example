# Docker: http://agent-api:8000  (service-to-service via Docker network)
# Local dev: http://localhost:8000
BACKEND_URL=http://agent-api:8000
# Keep this equal to BACKEND_API_TOKEN in env/agent/.env. This stays server-side; never prefix NEXT_PUBLIC_.
BACKEND_API_TOKEN=replace-with-the-same-random-token-as-env-agent-env
# Optional in development (a local-only key is used when absent); required for production deployments.
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
WATCHPACK_POLLING=true
# GitHub SSO: create an OAuth App at https://github.com/settings/developers with callback URL ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
# Comma-separated GitHub usernames allowed to sign in. Sign-in is disabled while empty.
GITHUB_ALLOWED_USERS=
# Public URL of this app (used for the OAuth callback).
APP_URL=http://localhost:3000
